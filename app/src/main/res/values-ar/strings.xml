    <!--tutorial digital assistant dialog-->

    <string name="digital_assistant_tutorial_title">كيفية استخدام المساعد الرقمي</string>
    <!--tutorials-->
    <string name="assistant_tutorial_edge_gestures">استخدام إيماءات حافة الشاشة</string>
    <string name="assistant_tutorial_edge_gestures_summary">على الأجهزة التي تستخدم التنقل بالإيماءات (أندرويد 10 والإصدارات الأحدث)، اسحب لأعلى وللداخل من أي من الزاويتين السفليتين للشاشة. سيظهر قوس متوهج من الزاوية لتأكيد فتح المساعد الرقمي. لكي يعمل هذا، يجب تحديد <b>التنقل بالإيماءات</b> كوضع تنقل النظام في إعدادات جهازك.</string>

    <string name="assistant_tutorial_home_button">استخدام زر التنقل الرئيسي</string>
    <string name="assistant_tutorial_home_button_summary">إذا كان جهازك يستخدم التنقل بثلاثة أزرار، فاضغط مع الاستمرار على زر الصفحة الرئيسة المركزي للحظة. هذا الإجراء مخصص عادةً لفتح المساعد الرقمي. إذا كان هذا الإجراء يؤدي وظيفة مختلفة، فربما يكون قد تم تخصيصه بواسطة الشركة المصنعة لجهازك.</string>

    <string name="assistant_tutorial_power_button">استخدام زر الطاقة</string>
    <string name="assistant_tutorial_power_button_summary">تسمح العديد من الأجهزة بفتح المساعد الرقمي عن طريق الضغط مدة على زر الطاقة. إذا ظهرت قائمة الطاقة عند الفعل من (ذلك)، فمن المحتمل أن تكون المِيزة معطلة. يمكنك غالبًا تمكينها في إعدادات نظامك، عادةً ضمن مسار مثل <b>الإعدادات &gt; النظام &gt; الإيماءات &gt; الضغط مع الاستمرار على زر الطاقة</b>.</string>

    <string name="assistant_tutorial_headset_button">استخدام سماعات الرأس السلكية والبلوتوث</string>
    <string name="assistant_tutorial_headset_button_summary">تسمح العديد من سماعات الرأس السلكية واللاسلكية بفتح المساعد الرقمي عن طريق الضغط مدة على الزر متعدد الوظائف. يُستخدم هذا الزر عادةً للتحكم في تشغيل الوسائط أو الرد على المكالمات، ولكن يمكنه أيضًا فتح المساعد حسب طراز سماعة الرأس. قد تفتح إيماءات النقر على بعض سماعات الأذن اللاسلكية مثل <b>النقر المزدوج</b> أيضًا المساعد الرقمي إذا كان مدعومًا ومُكوَّنًا في التطبيق.</string>

