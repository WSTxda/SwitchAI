    <string name="digital_assistant_setup_title">App di assistente digitale predefinita</string>
    <string name="digital_assistant_setup_message">Nelle impostazioni, seleziona <b>SwitchAI</b> come app di assistente digitale predefinita per accedere rapidamente all\'assistente scelto con gesti, pulsanti e altro…</string>
