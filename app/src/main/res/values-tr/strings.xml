    <string name="digital_assistant_setup_title">Varsayılan dijital asistan uygulaması</string>
    <!--messages-->
    <string name="digital_assistant_setup_message">Seçili asistana hareketler, düğmeler ve daha fazlasını kullanarak hızla erişmek için ayarlardan <b>SwitchAI</b> uygulamasını varsayılan dijital asistanınız olarak seçin…</string>
