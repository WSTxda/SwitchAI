    <!--tutorial digital assistant dialog-->

    <string name="digital_assistant_tutorial_title">How to use the digital assistant</string>
    <!--tutorials-->
    <string name="assistant_tutorial_edge_gestures">Using screen edge gestures</string>
    <string name="assistant_tutorial_edge_gestures_summary">On devices using gesture navigation (Android 10+), swipe up and in from either of the bottom corners of the screen. A glowing arc will appear from the corner to confirm that the digital assistant is opening. For this to work, <b>Gesture navigation</b> must be selected as the system navigation mode in your device\’s settings.</string>

    <string name="assistant_tutorial_home_button">Using the home navigation button</string>
    <string name="assistant_tutorial_home_button_summary">If your device uses the 3-button navigation, press and hold the center home button for a moment. This action is typically reserved to open the digital assistant. If this action performs a different function, it may have been customized by your device\’s manufacturer.</string>

    <string name="assistant_tutorial_power_button">Using the power button</string>
    <string name="assistant_tutorial_power_button_summary">Many devices allow you to open the digital assistant by long-pressing the power button. If the power menu appears when you do this, the feature is likely disabled. You can often enable it in your system settings, typically under a path like <b>Settings &gt; System &gt; Gestures &gt; Press and hold power button</b>.</string>

    <string name="assistant_tutorial_headset_button">Using wired and Bluetooth headsets</string>
    <string name="assistant_tutorial_headset_button_summary">Many wired and Bluetooth headsets allow you to open the digital assistant by long-pressing the multifunction button. This button is usually used to control media playback or answer calls, but can also open the assistant depending on your headset model. Tap gestures on some wireless earbuds like <b>double-tap</b> may also open the digital assistant if supported and configured in the app.</string>

